<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StrataVelyx.MainPage"
             Title="WorldMap"
             BackgroundColor="#1a1a1a">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Status Bar -->
        <Border Grid.Row="0"
                BackgroundColor="#2d2d2d"
                Stroke="#3d3d3d"
                StrokeThickness="0,0,1,0"
                Padding="8,4">
            <Label x:Name="StatusLabel"
                   Text="🌍 World Map Ready - Use menu bar to import data"
                   TextColor="#95A5A6"
                   FontSize="10"
                   VerticalOptions="Center" />
        </Border>
        
        <!-- Main Content Grid -->
        <Grid Grid.Row="1" ColumnDefinitions="250,*,300" Padding="0">
        
        <!-- Layers Panel (Left) -->
        <Border Grid.Column="0"
                BackgroundColor="#252525"
                Stroke="#3d3d3d"
                StrokeThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Padding="8">
                <!-- Layers Header -->
                <Label Grid.Row="0" 
                       Text="Layers"
                       TextColor="#E0E0E0"
                       FontSize="14"
                       FontAttributes="Bold"
                       Margin="0,0,0,8" />
                
                <!-- Layers List -->
                <ScrollView Grid.Row="1">
                    <StackLayout x:Name="LayersStack" Spacing="4">
                        <!-- Layers will be added dynamically -->
                    </StackLayout>
                </ScrollView>
                
                <!-- Action Buttons -->
                <StackLayout Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                    <Button x:Name="ImportPolygonsButton"
                            Text="📐 Import Polygons"
                            FontSize="11"
                            HeightRequest="32"
                            BackgroundColor="#7E57C2"
                            TextColor="White"
                            CornerRadius="4"
                            Clicked="OnImportPolygonsClicked" />
                    
                    <Button x:Name="TestButton"
                            Text="🔬 Test Spatial Ops"
                            FontSize="11"
                            HeightRequest="32"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            CornerRadius="4"
                            Clicked="OnTestButtonClicked" />
                </StackLayout>
            </Grid>
        </Border>
        
        <!-- Map View (Center) -->
        <Grid Grid.Column="1">
            <WebView x:Name="MapWebView"
                     BackgroundColor="#1a1a1a" />
        </Grid>
        
        <!-- Chat Panel (Right) -->
        <Border Grid.Column="2"
                BackgroundColor="#252525"
                Stroke="#3d3d3d"
                StrokeThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto" Padding="8">
                <!-- Chat Header -->
                <Label Grid.Row="0"
                       Text="Chat / Commands"
                       TextColor="#E0E0E0"
                       FontSize="14"
                FontAttributes="Bold"
                       Margin="0,0,0,8" />
                
                <!-- Chat History -->
                <ScrollView Grid.Row="1">
                    <StackLayout x:Name="ChatHistoryStack" Spacing="4">
                        <Label Text="Welcome to StrataVelyx"
                               TextColor="#95A5A6"
                               FontSize="12"
                               Margin="0,0,0,4" />
                        <Label Text="Type commands or use the map tools to get started."
                               TextColor="#6E6E6E"
                               FontSize="11"
                               LineBreakMode="WordWrap" />
                    </StackLayout>
                </ScrollView>
                
                <!-- Chat Input -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,8,0,0">
                    <Entry Grid.Column="0"
                           x:Name="ChatEntry"
                           Placeholder="Type command..."
                           PlaceholderColor="#6E6E6E"
                           TextColor="#E0E0E0"
                           BackgroundColor="#1a1a1a"
                           HeightRequest="36"
                           FontSize="12"
                           Completed="OnSendCommand" />
                    <Button Grid.Column="1"
                            x:Name="SendButton"
                            Text="Send"
                            FontSize="11"
                            HeightRequest="36"
                            BackgroundColor="#27AE60"
                TextColor="White"
                            CornerRadius="4"
                            Padding="12,0"
                            Clicked="OnSendCommand" />
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>

</ContentPage>
