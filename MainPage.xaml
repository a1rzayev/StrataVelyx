<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="StrataVelyx.MainPage"
             Title="StrataVelyx - Reservoir GIS">

    <Grid RowDefinitions="*,Auto,Auto" Padding="0">
        
        <!-- Map View -->
        <mapsui:MapControl x:Name="MapView" 
                          Grid.Row="0"
                          BackgroundColor="#E0E0E0" />
        
        <!-- Status Bar -->
        <Border Grid.Row="1" 
                BackgroundColor="#2C3E50"
                Padding="10,8">
            <Label x:Name="StatusLabel"
                   Text="Ready"
                   TextColor="White"
                   FontSize="12"
                   LineBreakMode="TailTruncation" />
        </Border>
        
        <!-- Chat/Command Interface -->
        <Border Grid.Row="2" 
                BackgroundColor="#34495E"
                Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                
                <!-- Import Button -->
                <Button Grid.Column="0"
                        x:Name="ImportButton"
                        Text="📁"
                        FontSize="18"
                        WidthRequest="50"
                        HeightRequest="44"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        CornerRadius="6"
                        Clicked="OnImportClicked" />
                
                <!-- Command Input -->
                <Entry Grid.Column="1"
                       x:Name="ChatEntry"
                       Placeholder="Type command (e.g., 'show injectors only')"
                       PlaceholderColor="#95A5A6"
                       TextColor="White"
                       BackgroundColor="#2C3E50"
                       HeightRequest="44"
                       Completed="OnSendCommand" />
                
                <!-- Send Button -->
                <Button Grid.Column="2"
                        x:Name="SendButton"
                        Text="Send"
                        HeightRequest="44"
                        BackgroundColor="#27AE60"
                        TextColor="White"
                        CornerRadius="6"
                        Clicked="OnSendCommand" />
                
                <!-- Export Button -->
                <Button Grid.Column="3"
                        x:Name="ExportButton"
                        Text="💾"
                        FontSize="18"
                        WidthRequest="50"
                        HeightRequest="44"
                        BackgroundColor="#E67E22"
                        TextColor="White"
                        CornerRadius="6"
                        Clicked="OnExportClicked" />
            </Grid>
        </Border>
        
        <!-- Chat History Overlay (hidden by default) -->
        <Border x:Name="ChatHistoryPanel"
                Grid.Row="0"
                Grid.RowSpan="3"
                BackgroundColor="#CC000000"
                IsVisible="False"
                Padding="20">
            <Grid RowDefinitions="Auto,*,Auto">
                <Label Grid.Row="0" 
                       Text="Command History"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       Margin="0,0,0,10" />
                
                <ScrollView Grid.Row="1">
                    <CollectionView x:Name="ChatHistoryView"
                                    BackgroundColor="Transparent">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}"
                                       TextColor="White"
                                       FontSize="14"
                                       Margin="0,2"
                                       LineBreakMode="WordWrap" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
                
                <Button Grid.Row="2"
                        Text="Close"
                        BackgroundColor="#E74C3C"
                        TextColor="White"
                        Margin="0,10,0,0"
                        Clicked="OnCloseHistory" />
            </Grid>
        </Border>
        
        <!-- Help Button (Floating) -->
        <Button x:Name="HelpButton"
                Grid.Row="0"
                Text="?"
                FontSize="20"
                FontAttributes="Bold"
                WidthRequest="50"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#9B59B6"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,20"
                Clicked="OnHelpClicked" />
    </Grid>

</ContentPage>
