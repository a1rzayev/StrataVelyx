<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StrataVelyx.MainPage"
             Title="StrataVelyx - Reservoir GIS"
             BackgroundColor="#1a1a1a">

    <Grid ColumnDefinitions="250,*,300" RowDefinitions="Auto,*" Padding="0">
        
        <!-- Top Toolbar -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0"
                BackgroundColor="#2d2d2d"
                Stroke="#3d3d3d"
                StrokeThickness="0,0,0,1"
                Padding="8,6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        x:Name="ImportButton"
                        Text="📁 Import"
                        FontSize="12"
                        HeightRequest="32"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        CornerRadius="4"
                        Padding="8,0"
                        Clicked="OnImportClicked" />
                
                <Button Grid.Column="1"
                        x:Name="DrawPolygonButton"
                        Text="✏️ Draw"
                        FontSize="12"
                        HeightRequest="32"
                        BackgroundColor="#27AE60"
                        TextColor="White"
                        CornerRadius="4"
                        Padding="8,0"
                        Clicked="OnDrawPolygonClicked" />
                
                <Button Grid.Column="2"
                        x:Name="ZoomToFitButton"
                        Text="🔍 Fit"
                        FontSize="12"
                        HeightRequest="32"
                        BackgroundColor="#9B59B6"
                        TextColor="White"
                        CornerRadius="4"
                        Padding="8,0"
                        Clicked="OnZoomToFitClicked" />
                
                <Button Grid.Column="3"
                        x:Name="ExportButton"
                        Text="💾 Export"
                        FontSize="12"
                        HeightRequest="32"
                        BackgroundColor="#E67E22"
                        TextColor="White"
                        CornerRadius="4"
                        Padding="8,0"
                        Clicked="OnExportClicked" />
                
                <Label Grid.Column="4"
                       x:Name="StatusLabel"
                       Text="Ready"
                       TextColor="#95A5A6"
                       FontSize="11"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       Margin="8,0,0,0" />
            </Grid>
        </Border>
        
        <!-- Layers Panel (Left) -->
        <Border Grid.Column="0" Grid.Row="1"
                BackgroundColor="#252525"
                Stroke="#3d3d3d"
                StrokeThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Padding="8">
                <!-- Layers Header -->
                <Label Grid.Row="0"
                       Text="Layers"
                       TextColor="#E0E0E0"
                       FontSize="14"
                       FontAttributes="Bold"
                       Margin="0,0,0,8" />
                
                <!-- Layers List -->
                <ScrollView Grid.Row="1">
                    <StackLayout x:Name="LayersStack" Spacing="4">
                        <!-- Layers will be added dynamically -->
                    </StackLayout>
                </ScrollView>
                
                <!-- Test Button -->
                <Button Grid.Row="2"
                        x:Name="TestButton"
                        Text="Load Test GeoJSON"
                        FontSize="11"
                        HeightRequest="32"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="4"
                        Margin="0,8,0,0"
                        Clicked="OnTestButtonClicked" />
            </Grid>
        </Border>
        
        <!-- Map View (Center) -->
        <Grid Grid.Column="1" Grid.Row="1">
            <WebView x:Name="MapWebView"
                     BackgroundColor="#1a1a1a" />
        </Grid>
        
        <!-- Chat Panel (Right) -->
        <Border Grid.Column="2" Grid.Row="1"
                BackgroundColor="#252525"
                Stroke="#3d3d3d"
                StrokeThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto" Padding="8">
                <!-- Chat Header -->
                <Label Grid.Row="0"
                       Text="Chat / Commands"
                       TextColor="#E0E0E0"
                       FontSize="14"
                       FontAttributes="Bold"
                       Margin="0,0,0,8" />
                
                <!-- Chat History -->
                <ScrollView Grid.Row="1">
                    <StackLayout x:Name="ChatHistoryStack" Spacing="4">
                        <Label Text="Welcome to StrataVelyx"
                               TextColor="#95A5A6"
                               FontSize="12"
                               Margin="0,0,0,4" />
                        <Label Text="Type commands or use the map tools to get started."
                               TextColor="#6E6E6E"
                               FontSize="11"
                               LineBreakMode="WordWrap" />
                    </StackLayout>
                </ScrollView>
                
                <!-- Chat Input -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,8,0,0">
                    <Entry Grid.Column="0"
                           x:Name="ChatEntry"
                           Placeholder="Type command..."
                           PlaceholderColor="#6E6E6E"
                           TextColor="#E0E0E0"
                           BackgroundColor="#1a1a1a"
                           HeightRequest="36"
                           FontSize="12"
                           Completed="OnSendCommand" />
                    <Button Grid.Column="1"
                            x:Name="SendButton"
                            Text="Send"
                            FontSize="11"
                            HeightRequest="36"
                            BackgroundColor="#27AE60"
                            TextColor="White"
                            CornerRadius="4"
                            Padding="12,0"
                            Clicked="OnSendCommand" />
                </Grid>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
